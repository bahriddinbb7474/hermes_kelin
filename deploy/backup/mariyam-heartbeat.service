[Unit]
Description=Hermes Mariyam daily admin heartbeat
After=network-online.target
Wants=network-online.target
[Service]
Type=oneshot
User=timeagent
Group=timeagent
EnvironmentFile=/opt/hermes-mariyam-secrets/backup-heartbeat.env
ExecStart=/usr/bin/python3 /opt/hermes-mariyam/deploy/backup/mariyam-heartbeat.py
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ReadOnlyPaths=/opt/hermes-mariyam /opt/hermes-mariyam-secrets
