[Unit]
Description=Hermes Mariyam encrypted backup
Wants=network-online.target
After=network-online.target docker.service
OnFailure=mariyam-heartbeat-failure@%n.service

[Service]
Type=oneshot
User=timeagent
Group=timeagent
ExecStart=/opt/hermes-mariyam/deploy/backup/mariyam-backup.sh
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ReadWritePaths=/opt/hermes-mariyam/var/backup /home/timeagent/.config/rclone
ReadOnlyPaths=/opt/hermes-mariyam /opt/hermes-mariyam-secrets /home/timeagent/.hermes
